# Canonical origin used for canonical URLs, Open Graph URLs and the sitemap.
SITE_URL=https://ariaappliancerepair.com

# Set to "true" for staging / preview builds: adds <meta name="robots" content="noindex">
# on every page and serves a Disallow-all robots.txt.
PUBLIC_NOINDEX=false

# CRM / form endpoint. Leave empty until the CRM is live.
# Empty  -> the request form runs in "pending" mode: it composes an email to
#           contact@ariaappliancerepair.com in the visitor's own mail app and
#           keeps the phone line as the primary path. Nothing is faked.
# Set    -> the form POSTs to this URL and the CRM should redirect to /thank-you/.
PUBLIC_FORM_ENDPOINT=
