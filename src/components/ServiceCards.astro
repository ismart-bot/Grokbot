---
import Icon from './Icon.astro';
import { services, serviceHref, type Service } from '../data/services';

interface Props {
  items?: Service[];
  detailed?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { items = services, detailed = false, headingLevel: H = 'h3' } = Astro.props;
---

<ul class:list={['svc-grid', { 'svc-grid--detailed': detailed, 'svc-grid--few': items.length < 4 }]}>
  {
    items.map((s) => (
      <li class="svc-card has-stretched">
        <div class="svc-card__top">
          <span class="num">{s.num}</span>
          <span class="svc-card__icon">
            <Icon name={s.slug} size={26} />
          </span>
        </div>
        <H class="svc-card__title">
          <a class="stretched" href={serviceHref(s.slug)}>
            {s.name}
            <span class="sr-only"> repair &amp; install</span>
          </a>
        </H>
        <p class="svc-card__blurb">{s.cardBlurb}</p>
        {detailed && (
          <ul class="svc-card__sym">
            {s.symptoms.slice(0, 3).map((sym) => (
              <li>{sym.title}</li>
            ))}
          </ul>
        )}
        <ul class="tags" aria-label="Covers">
          {s.covers.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
        <span class="svc-card__cta" aria-hidden="true">
          {s.name} repair
          <Icon name="arrow" size={18} />
        </span>
      </li>
    ))
  }
</ul>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  @media (min-width: 600px) {
    .svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .svc-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .svc-grid--few {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(22px, 2vw, 28px);
    background: var(--char);
    transition: background-color 0.18s ease;
  }

  :global(.band--ink) .svc-card {
    background: var(--ink);
  }

  .svc-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--teal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }

  .svc-card:hover {
    background: var(--char-2);
  }

  :global(.band--ink) .svc-card:hover {
    background: #222224;
  }

  .svc-card:hover::before {
    transform: scaleX(1);
  }

  .svc-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .svc-card__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--teal-edge);
    border-radius: 50%;
    color: var(--teal);
    background: var(--teal-wash);
  }

  .svc-card__title {
    font-size: clamp(1.1875rem, 1.05rem + 0.35vw, 1.375rem);
  }

  .svc-card__title a {
    text-decoration: none;
  }

  .svc-card__blurb {
    color: var(--on-dark-2);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .svc-card__sym {
    display: grid;
    gap: 6px;
    list-style: none;
    padding: 12px 0 2px;
    border-top: 1px solid var(--line-soft);
    font-size: 0.9375rem;
    color: var(--on-dark);
  }

  .svc-card__sym li {
    display: grid;
    grid-template-columns: 12px 1fr;
    gap: 8px;
  }

  .svc-card__sym li::before {
    content: '';
    width: 6px;
    height: 6px;
    margin-top: 0.6em;
    border-radius: 50%;
    background: var(--teal);
  }

  .svc-card .tags {
    margin-top: auto;
    padding-top: 4px;
  }

  .svc-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-top: 6px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--teal);
  }

  .svc-card__cta :global(svg) {
    transition: transform 0.18s ease;
  }

  .svc-card:hover .svc-card__cta :global(svg) {
    transform: translateX(4px);
  }
</style>
