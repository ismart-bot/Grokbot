---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, requestHref, site } from '../config/site';
import { services, serviceHref } from '../data/services';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="site-header__inner">
    <Logo />

    <nav class="nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="hdr-phone" href={site.phone.href} data-track="call-header">
      <span class="hdr-phone__icon"><Icon name="phone" size={20} /></span>
      <span class="hdr-phone__text">
        <span class="hdr-phone__label">{site.hours.short}</span>
        <span class="hdr-phone__num">{site.phone.display}</span>
      </span>
    </a>

    <details class="menu" data-menu>
      <summary class="menu__btn">
        <Icon name="menu" size={22} class="menu__icon-open" />
        <Icon name="close" size={22} class="menu__icon-close" />
        <span>Menu</span>
      </summary>
      <div class="menu__panel">
        <div class="menu__cta">
          <a class="btn btn--primary btn--block" href={site.phone.href} data-track="call-menu">
            <Icon name="phone" size={20} />Call {site.phone.display}
          </a>
          <a class="btn btn--ghost btn--block" href={requestHref} data-track="request-menu">Request service</a>
          <p class="menu__hours">{site.hours.long} · {site.area.short}</p>
        </div>
        <nav aria-label="Menu">
          <ul class="menu__main">
            <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="menu__label">Services 01–08</p>
          <ul class="menu__services">
            {
              services.map((s) => (
                <li>
                  <a href={serviceHref(s.slug)} aria-current={path === serviceHref(s.slug) ? 'page' : undefined}>
                    <span class="num">{s.num}</span> {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 60;
    background: rgba(26, 26, 27, 0.97);
    border-bottom: 1px solid var(--line-soft);
  }

  @media (min-width: 768px) {
    .site-header {
      position: sticky;
      top: 0;
      background: rgba(26, 26, 27, 0.92);
      -webkit-backdrop-filter: saturate(140%) blur(10px);
      backdrop-filter: saturate(140%) blur(10px);
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 40px);
    min-height: var(--header-h);
    max-width: calc(var(--frame) + 2 * var(--pad-x));
    margin-inline: auto;
    padding-inline: var(--pad-x);
  }

  /* Primary nav */
  .nav {
    display: none;
    margin-left: auto;
  }

  .nav ul {
    display: flex;
    gap: clamp(18px, 2vw, 34px);
    list-style: none;
  }

  .nav a {
    position: relative;
    display: inline-block;
    padding: 10px 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--on-dark-2);
    text-decoration: none;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 2px;
    background: var(--teal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.18s ease;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--on-dark);
  }

  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* Phone */
  .hdr-phone {
    display: none;
    align-items: center;
    gap: 10px;
    margin-left: auto;
    color: var(--teal);
    text-decoration: none;
    flex: none;
  }

  .hdr-phone__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--teal-edge);
    border-radius: 50%;
    background: var(--teal-wash);
  }

  .hdr-phone__text {
    display: grid;
    line-height: 1.15;
  }

  .hdr-phone__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--on-dark-3);
  }

  .hdr-phone__num {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .hdr-phone:hover .hdr-phone__num {
    color: var(--teal-hi);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .hdr-phone {
      display: inline-flex;
    }
  }

  @media (min-width: 900px) {
    .nav {
      display: block;
    }
    .hdr-phone {
      margin-left: 0;
    }
  }

  @media (min-width: 900px) and (max-width: 1099.98px) {
    .hdr-phone__icon {
      display: none;
    }
  }

  /* Menu (<900px) */
  .menu {
    margin-left: auto;
  }

  @media (min-width: 768px) {
    .menu {
      margin-left: 0;
    }
  }

  @media (min-width: 900px) {
    .menu {
      display: none;
    }
  }

  .menu__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  .menu__btn::-webkit-details-marker {
    display: none;
  }

  .menu__btn:hover {
    border-color: var(--teal);
  }

  .menu :global(.menu__icon-close) {
    display: none;
  }

  .menu[open] :global(.menu__icon-close) {
    display: block;
  }

  .menu[open] :global(.menu__icon-open) {
    display: none;
  }

  .menu__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding: 20px var(--pad-x) 28px;
    background: var(--ink);
    border-top: 1px solid var(--line-soft);
    border-bottom: 4px solid var(--teal);
    box-shadow: 0 24px 40px -12px rgba(0, 0, 0, 0.7);
  }

  .menu__cta {
    display: grid;
    gap: 10px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line-soft);
  }

  .menu__hours {
    font-size: 0.9375rem;
    color: var(--on-dark-2);
    text-align: center;
  }

  .menu__main,
  .menu__services {
    list-style: none;
  }

  .menu__main {
    display: grid;
    padding: 8px 0;
  }

  .menu__main a {
    display: block;
    padding: 12px 0;
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--line-soft);
  }

  .menu__main a[aria-current='page'],
  .menu__services a[aria-current='page'] {
    color: var(--teal);
  }

  .menu__label {
    margin: 18px 0 8px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .menu__services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 16px;
  }

  .menu__services a {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 10px 0;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('details[data-menu]').forEach((menu) => {
    const summary = menu.querySelector('summary');
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => (menu.open = false)));
    const wide = window.matchMedia('(min-width: 900px)');
    wide.addEventListener('change', () => {
      if (wide.matches) menu.open = false;
    });
  });
</script>
