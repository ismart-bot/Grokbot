---
/**
 * Interim wordmark. The dial mark carries eight ticks — one per service lane (01–08).
 * Swap for the client master logo: replace this component's markup with
 * <img src="/images/brand/aria-logo.svg" …> once the file is supplied.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const ticks = Array.from({ length: 8 }, (_, i) => i * 45);
---

<a class:list={['logo', className]} href="/" aria-label="Aria Appliance Repair — home">
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <circle cx="20" cy="20" r="12.2" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
    <circle cx="20" cy="20" r="4.4" fill="currentColor"></circle>
    {
      ticks.map((deg) => (
        <line
          x1="20"
          y1="2.6"
          x2="20"
          y2="5.4"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          transform={`rotate(${deg} 20 20)`}
        />
      ))
    }
  </svg>
  <span class="logo__word">
    <span class="logo__name">Aria</span>
    <span class="logo__sub">Appliance Repair</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--on-dark);
    text-decoration: none;
    flex: none;
  }

  .logo__mark {
    width: 38px;
    height: 38px;
    color: var(--teal);
  }

  .logo__word {
    display: grid;
    line-height: 1;
  }

  .logo__name {
    font-size: 1.3125rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .logo__sub {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal);
  }

  @media (max-width: 359.98px) {
    .logo__mark {
      width: 32px;
      height: 32px;
    }
    .logo__name {
      font-size: 1.125rem;
    }
  }
</style>
