---
/**
 * Inline stroke icons (24×24, currentColor). Appliance glyphs mirror the 01–08 service grammar.
 */
export type UiIcon =
  | 'phone'
  | 'arrow'
  | 'check'
  | 'x'
  | 'clock'
  | 'pin'
  | 'shield'
  | 'bolt'
  | 'mail'
  | 'menu'
  | 'close'
  | 'alert'
  | 'quote'
  | 'wrench';

interface Props {
  name: UiIcon | import('../data/services').IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;

const paths: Record<string, string> = {
  // appliances
  refrigerator:
    '<rect x="5" y="2.5" width="14" height="19" rx="2"/><path d="M5 10h14"/><path d="M8.5 5.4v2.2M8.5 12.8v3.6"/><path d="M7.5 21.5v1M16.5 21.5v1"/>',
  'oven-stove':
    '<rect x="3.5" y="3" width="17" height="18" rx="2"/><path d="M3.5 8h17"/><circle cx="7" cy="5.5" r=".9"/><circle cx="10.2" cy="5.5" r=".9"/><path d="M14 5.5h3.5"/><rect x="7" y="11" width="10" height="6.5" rx="1"/><path d="M9 13.2h6"/>',
  washer:
    '<rect x="4" y="2.5" width="16" height="19" rx="2"/><path d="M4 7h16"/><circle cx="12" cy="14.2" r="4.6"/><path d="M9.4 14.9c1-.9 2.1-.9 3.1 0s2.2.9 3.1 0"/><circle cx="7" cy="4.75" r=".7"/><path d="M13 4.75h4"/>',
  dryer:
    '<rect x="4" y="2.5" width="16" height="19" rx="2"/><path d="M4 7h16"/><circle cx="12" cy="14.2" r="4.6"/><circle cx="12" cy="14.2" r="1.9"/><circle cx="7" cy="4.75" r=".7"/><circle cx="9.6" cy="4.75" r=".7"/><path d="M14 4.75h3"/>',
  dishwasher:
    '<rect x="4" y="2.5" width="16" height="19" rx="2"/><path d="M4 7h16"/><path d="M7.5 4.75h9"/><path d="M7 12h10M7 16.8h10"/><path d="M9 12v-1.8M12 12v-1.8M15 12v-1.8M9 16.8v-1.8M12 16.8v-1.8M15 16.8v-1.8"/>',
  'range-hood':
    '<path d="M9.5 2.5h5v6l6.5 5.6v2.4H3v-2.4l6.5-5.6z"/><path d="M3 14.1h18"/><path d="M8 19l-.8 2.2M12 19v2.4M16 19l.8 2.2"/>',
  'steam-unit':
    '<rect x="4.5" y="14" width="15" height="7.5" rx="1.6"/><path d="M8 12c-1.1-1.3 1.1-2.4 0-3.7s1.1-2.4 0-3.8M12 12c-1.1-1.3 1.1-2.4 0-3.7s1.1-2.4 0-3.8M16 12c-1.1-1.3 1.1-2.4 0-3.7s1.1-2.4 0-3.8"/><circle cx="15.8" cy="17.75" r="1.2"/><path d="M7.5 17.75h4"/>',
  'sauna-unit':
    '<rect x="4.5" y="12.5" width="15" height="9" rx="1.6"/><path d="M6.5 12.5c0-1.4 1-2.2 2.2-2.2s2 .8 2.2 1.4c.3-1 1.3-1.8 2.4-1.8 1.4 0 2.4 1 2.4 2.1.4-.5 1-.8 1.6-.8.8 0 1.2.5 1.2 1.3"/><path d="M8 7.5c.8-1-.8-1.8 0-2.9M12 6.8c.8-1-.8-1.8 0-2.9M16 7.5c.8-1-.8-1.8 0-2.9"/><path d="M8 17h8"/>',
  // ui
  phone:
    '<path d="M5.2 3.5h3.3l1.7 4.3-2.2 1.4a11.5 11.5 0 0 0 6.8 6.8l1.4-2.2 4.3 1.7v3.3a1.7 1.7 0 0 1-1.8 1.7A16.8 16.8 0 0 1 3.5 5.3a1.7 1.7 0 0 1 1.7-1.8z"/>',
  arrow: '<path d="M4.5 12h15M13.5 6l6 6-6 6"/>',
  check: '<path d="M4.5 12.5l4.6 4.6L19.5 6.8"/>',
  x: '<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>',
  clock: '<circle cx="12" cy="12" r="8.6"/><path d="M12 7.4V12l3.2 2.1"/>',
  pin: '<path d="M12 21.3s-6.6-6.1-6.6-11.1a6.6 6.6 0 0 1 13.2 0c0 5-6.6 11.1-6.6 11.1z"/><circle cx="12" cy="10.1" r="2.4"/>',
  shield: '<path d="M12 2.8l7.3 3v5.7c0 4.5-3.1 8.2-7.3 9.7-4.2-1.5-7.3-5.2-7.3-9.7V5.8z"/><path d="M8.8 12l2.3 2.3 4.2-4.4"/>',
  bolt: '<path d="M13.2 2.5 5.4 13.6h6.1l-.8 7.9 7.9-11.3h-6.2z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.6 6.6 12 13l8.4-6.4"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  alert: '<path d="M12 3.6 21.2 19.8H2.8z"/><path d="M12 9.8v4.6M12 17.1v.2"/>',
  quote: '<path d="M4.5 5.5h15v10h-9l-4.5 3.5v-3.5h-1.5z"/><path d="M8.5 9.5h7M8.5 12.2h4.5"/>',
  wrench:
    '<path d="M14.8 3.6a4.8 4.8 0 0 0-5.6 6.5l-5.6 5.6a1.9 1.9 0 0 0 2.7 2.7l5.6-5.6a4.8 4.8 0 0 0 6.5-5.6l-2.9 2.9-2.4-.3-.3-2.4z"/>',
};

const body = paths[name] ?? '';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
></svg>
