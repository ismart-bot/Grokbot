---
import fs from 'node:fs';
import path from 'node:path';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { site } from '../config/site';
import { services, serviceHref } from '../data/services';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const { title, description, noindex = false, schema = [] } = Astro.props;

const origin = Astro.site ?? new URL('https://ariaappliancerepair.com');
const canonical = new URL(Astro.url.pathname, origin).href;
const robots = site.noindex || noindex ? 'noindex, nofollow' : 'index, follow';

const ogFile = path.join(process.cwd(), 'public', 'images', 'og-default.jpg');
const ogImage = fs.existsSync(ogFile) ? new URL('/images/og-default.jpg', origin).href : undefined;

const businessId = new URL('/#business', origin).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': businessId,
  name: site.name,
  description: 'Residential appliance repair and install in Vaughan, Ontario — Woodbridge included.',
  url: new URL('/', origin).href,
  telephone: site.phone.display,
  email: site.email,
  ...(ogImage ? { image: ogImage } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.area.city,
    addressRegion: site.area.provinceCode,
    addressCountry: site.area.country,
  },
  areaServed: {
    '@type': 'City',
    name: `${site.area.city}, ${site.area.province}`,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: site.hours.days,
      opens: site.hours.opens,
      closes: site.hours.closes,
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Appliance repair & install services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: `${s.name} repair`,
        url: new URL(serviceHref(s.slug), origin).href,
      },
    })),
  },
};

const jsonLd = [business, ...schema];
---

<!doctype html>
<html lang="en-CA" data-variant={site.variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#1A1A1B" />
    <meta name="ab-variant" content={site.variant} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <StickyCta />
  </body>
</html>
