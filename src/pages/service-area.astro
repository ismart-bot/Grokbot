---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import type { QA } from '../data/services';

const afterHours = [
  {
    title: 'Fridge or freezer warm',
    body: 'Keep the doors closed and move the most perishable items to a cooler with ice. Call at 8am.',
  },
  {
    title: 'Washer leaking',
    body: 'Close the hot and cold taps behind the machine and switch it off. Don’t force a locked door.',
  },
  {
    title: 'Dishwasher leaking',
    body: 'Close the supply valve under the sink and switch off its breaker or unplug it.',
  },
  {
    title: 'Burning smell or sparking',
    body: 'Oven, dryer, steam unit or sauna heater — switch it off at the breaker and don’t use it until it’s checked.',
  },
];

const areaFaqs: QA[] = [
  {
    q: 'Is Woodbridge a separate city?',
    a: 'No — Woodbridge is a neighbourhood of the City of Vaughan, and it’s fully inside our service area. So are Maple, Concord, Kleinburg, Vellore Village and the Vaughan side of Thornhill.',
  },
  {
    q: 'I’m close to the Vaughan border — will you come?',
    a: 'Tell us your address when you call. If it’s inside Vaughan city limits, we’ll book it. If it isn’t, we’ll say so straight away rather than send someone out of area.',
  },
  {
    q: 'Can someone come after 10pm?',
    a: 'No. We’re not a 24/7 service and never claim to be. Calls and visits run Monday–Sunday, 8am–10pm. The steps on this page will keep most problems contained until the morning.',
  },
];
---

<BaseLayout
  title="Service Area | Appliance Repair in Vaughan Only — Woodbridge Included | Aria"
  description="Aria Appliance Repair serves Vaughan, Ontario only — Woodbridge, Maple, Concord, Kleinburg, Vellore Village and the Vaughan side of Thornhill. Monday–Sunday 8am–10pm. Not 24/7. Call +1-888-642-0352."
>
  <PageHero
    eyebrow="Service area · Vaughan, Ontario"
    title="Vaughan only — every neighbourhood inside the city."
    lede="We book appliance repairs inside Vaughan city limits and nowhere else. Woodbridge is a neighbourhood of Vaughan, not a separate city — and yes, we cover it. Short drives are what make same-day possible when the schedule allows."
    image="service-area"
    track="hero-area"
  >
    <ul class="chips">
      <li class="chip"><Icon name="pin" />Vaughan city limits</li>
      <li class="chip"><Icon name="clock" />{site.hours.short} · not 24/7</li>
    </ul>
  </PageHero>

  <section class="band band--paper band--seam" aria-labelledby="hoods-title">
    <div class="frame">
      <SectionHead eyebrow="Neighbourhoods" title="Communities we cover in Vaughan" id="hoods-title">
        <p>
          If your address is in the City of Vaughan, you’re in. These are the neighbourhood names we hear most on the
          phone — all of them inside Vaughan.
        </p>
      </SectionHead>
      <ul class="hoods">
        {
          site.area.neighbourhoods.map((n) => (
            <li>
              <Icon name="pin" size={20} />
              <span>
                <strong>{n}</strong>
                <span class="hoods__city">Vaughan, ON</span>
              </span>
            </li>
          ))
        }
        <li class="hoods__rest">
          <Icon name="check" size={20} />
          <span>
            <strong>Anywhere else in Vaughan</strong>
            <span class="hoods__city">Confirmed on the call</span>
          </span>
        </li>
      </ul>
      <div class="edge">
        <div>
          <h3>Outside Vaughan? We’re not the right call.</h3>
          <p>
            We don’t book outside Vaughan city limits, and we won’t pretend to cover a region we don’t. If you’re in
            a neighbouring city, you’ll get a straight answer on the phone — not a technician who arrives late from
            across the region.
          </p>
        </div>
        <a class="btn btn--ghost" href={site.phone.href} data-track="call-area-check">
          <Icon name="phone" size={20} />Check your address
        </a>
      </div>
    </div>
  </section>

  <section class="band band--ink" aria-labelledby="hours-title">
    <div class="frame hours-grid">
      <div>
        <p class="eyebrow">Hours</p>
        <h2 id="hours-title">Seven days a week, 8am to 10pm</h2>
        <p class="lede">
          Phones and visits run the same hours every day, weekends included. We’re not a 24/7 line — so when we give
          you a window, it’s one we can staff.
        </p>
        <table class="hours">
          <caption class="sr-only">Opening hours</caption>
          <tbody>
            {
              site.hours.days.map((day) => (
                <tr>
                  <th scope="row">{day}</th>
                  <td>
                    {site.hours.openLabel}–{site.hours.closeLabel}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div>
        <p class="eyebrow">After 10pm</p>
        <h2 class="h2-sm">Keep it safe until morning</h2>
        <p class="lede">Most overnight problems can be contained in two minutes. Then call us from 8am.</p>
        <ul class="safe">
          {
            afterHours.map((a) => (
              <li>
                <Icon name="alert" size={20} />
                <div>
                  <h3>{a.title}</h3>
                  <p>{a.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="band band--char" aria-labelledby="area-faq-title">
    <div class="frame faq-grid">
      <div>
        <p class="eyebrow">Coverage FAQ</p>
        <h2 id="area-faq-title">Area questions, answered</h2>
        <p class="lede">
          Not sure about an address? Call {site.phone.display} — it takes ten seconds to confirm.
        </p>
      </div>
      <FaqList items={areaFaqs} />
    </div>
  </section>

  <CtaBand
    title="Inside Vaughan? Let’s get it fixed."
    body={`Call ${site.phone.display} — we’ll confirm your address, the appliance and a window inside Monday–Sunday, 8am–10pm.`}
    track="band-area"
  />
</BaseLayout>

<style>
  .hoods {
    display: grid;
    gap: 10px;
    list-style: none;
  }

  @media (min-width: 560px) {
    .hoods {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .hoods {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .hoods li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    background: var(--white);
    border: 1px solid var(--paper-line);
    border-radius: var(--radius-sm);
  }

  .hoods li :global(svg) {
    color: var(--teal-deep);
    flex: none;
  }

  .hoods li > span {
    display: grid;
    line-height: 1.3;
  }

  .hoods__city {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-paper-2);
  }

  .hoods .hoods__rest {
    background: var(--char);
    border-color: var(--char);
    color: var(--on-dark);
  }

  .hoods .hoods__rest :global(svg) {
    color: var(--teal);
  }

  .hoods .hoods__rest .hoods__city {
    color: var(--on-dark-3);
  }

  .edge {
    display: grid;
    gap: 18px 40px;
    align-items: center;
    margin-top: clamp(24px, 3vw, 40px);
    padding: clamp(20px, 2.4vw, 30px);
    border: 1px solid var(--paper-line);
    border-left: 4px solid var(--teal-deep);
    border-radius: var(--radius-sm);
    background: var(--paper-2);
  }

  @media (min-width: 860px) {
    .edge {
      grid-template-columns: 1fr auto;
    }
  }

  .edge h3 {
    margin-bottom: 8px;
  }

  .edge p {
    color: var(--on-paper-2);
    max-width: 75ch;
  }

  .hours-grid {
    display: grid;
    gap: 48px 72px;
  }

  @media (min-width: 960px) {
    .hours-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .hours-grid h2 {
    margin-bottom: 12px;
  }

  .hours-grid .lede {
    margin-bottom: 22px;
  }

  .h2-sm {
    font-size: clamp(1.5rem, 1.05rem + 1.3vw, 2.125rem);
  }

  .hours {
    width: 100%;
    border-collapse: collapse;
  }

  .hours th,
  .hours td {
    padding: 12px 0;
    border-bottom: 1px solid var(--line-soft);
    text-align: left;
  }

  .hours th {
    font-weight: 600;
  }

  .hours td {
    text-align: right;
    font-family: var(--font-mono);
    color: var(--teal);
  }

  .safe {
    display: grid;
    gap: 12px;
    list-style: none;
  }

  .safe li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    padding: 16px 18px;
    background: var(--char);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .safe li :global(svg) {
    color: var(--teal);
    margin-top: 2px;
  }

  .safe h3 {
    margin-bottom: 4px;
    font-size: 1.0625rem;
  }

  .safe p {
    font-size: 0.9375rem;
    color: var(--on-dark-2);
  }

  .faq-grid {
    display: grid;
    gap: 32px 64px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .faq-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
    }
  }

  .faq-grid h2 {
    margin-bottom: 12px;
  }
</style>
