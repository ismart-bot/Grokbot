---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaPair from '../components/CtaPair.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import PromiseCards from '../components/PromiseCards.astro';
import BrandPills from '../components/BrandPills.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import { site, trustPoints } from '../config/site';
import { services, serviceBySlug, serviceHref } from '../data/services';
import { callChecklist, homeFaqs, homeProcess, homeSymptoms } from '../data/home';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Appliance Repair Vaughan | Fridge, Oven, Washer & Dryer Repair | Aria Appliance Repair"
  description="Residential appliance repair and install across Vaughan, Woodbridge included. Refrigerators, electric ovens, washers, dryers, dishwashers, range hoods, steam and sauna units. Mon–Sun 8am–10pm. Call +1-888-642-0352."
  schema={[faqSchema]}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <Photo slot="hero-cooktop" eager sizes="100vw" position="68% 50%" />
    </div>

    <div class="hero__body">
      <div class="hero__copy">
        <p class="eyebrow">Appliance repair &amp; install · Vaughan, ON</p>
        <h1 id="hero-title">Precision appliance repair for Vaughan homes.</h1>
        <p class="lede">
          Fridge warm, washer full of water, oven not heating? We repair and install eight home appliances across
          Vaughan — Woodbridge included — diagnose on site, and quote before any part is replaced.
        </p>
        <CtaPair id="hero-ctas" track="hero" />
        <ul class="chips">
          <li class="chip"><Icon name="clock" />{site.hours.short}</li>
          <li class="chip"><Icon name="pin" />Vaughan only · Woodbridge included</li>
        </ul>
        <ul class="trust">
          {
            trustPoints.map((t) => (
              <li>
                <Icon name="check" />
                <span>
                  <strong>{t.strong}</strong> {t.rest}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <nav class="hero__rail" aria-label="Services 01 to 08">
      <ul>
        {
          services.map((s) => (
            <li>
              <a href={serviceHref(s.slug)}>
                <span class="num">{s.num}</span>
                <span>{s.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  <section class="band band--char band--seam" aria-labelledby="services-title">
    <div class="frame">
      <SectionHead eyebrow="Primary services · 01–08" title="What we repair and install" id="services-title">
        <p>
          Eight residential appliance lanes, one standard: diagnose before quoting, repair when it makes sense, and
          say so plainly when it doesn’t. Ovens and stoves are electric only — no gas lines, no HVAC.
        </p>
        <a class="link-arrow" href="/services/">Compare all eight services <Icon name="arrow" /></a>
      </SectionHead>
      <ServiceCards />
    </div>
  </section>

  <section class="band band--ink" aria-labelledby="symptoms-title">
    <div class="frame">
      <SectionHead eyebrow="Common symptoms" title="Symptoms we see every week in Vaughan" id="symptoms-title">
        <p>
          If one of these sounds familiar, call before it grows — a slow leak or a failing fan rarely fixes itself.
          Each one links to the full appliance page with causes, what’s included and what to do while you wait.
        </p>
      </SectionHead>
      <ul class="sym-grid">
        {
          homeSymptoms.map((sym) => {
            const svc = serviceBySlug(sym.service);
            return (
              <li class="sym has-stretched">
                <span class="sym__icon">
                  <Icon name={sym.service} size={24} />
                </span>
                <h3>{sym.title}</h3>
                <p>{sym.detail}</p>
                <a class="link-arrow stretched" href={serviceHref(svc.slug)}>
                  {svc.name} repair <Icon name="arrow" />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="band band--paper" aria-labelledby="process-title">
    <div class="frame">
      <SectionHead eyebrow="How it works" title="From first call to finished repair" id="process-title">
        <p>
          Three steps, no surprises. You know the window before we arrive and the price before we start — and
          nothing is replaced until you say yes.
        </p>
      </SectionHead>
      <ProcessSteps steps={homeProcess} />
      <div class="ready">
        <p class="ready__title"><Icon name="quote" size={22} />Have these handy when you call</p>
        <ul>
          {
            callChecklist.map((c) => (
              <li>
                <strong>{c.label}</strong>
                <span>{c.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="band band--char" aria-labelledby="promise-title">
    <div class="frame">
      <SectionHead eyebrow="Our promise" title="Substance you can verify" id="promise-title">
        <p>
          Three commitments that hold on every job — written down, not implied. No invented ratings, no vague
          “lifetime” claims.
        </p>
      </SectionHead>
      <PromiseCards />
    </div>
  </section>

  <section class="band band--ink" aria-labelledby="about-title">
    <div class="frame about-grid">
      <div class="about-copy">
        <p class="eyebrow">About Aria</p>
        <h2 id="about-title">Local Vaughan specialists — calm, precise, residential.</h2>
        <p>
          Aria Appliance Repair is a Vaughan-based residential team. We keep our scope narrow on purpose: eight
          appliance lanes, one city, and hours we can actually staff — Monday to Sunday, 8am to 10pm.
        </p>
        <p>
          That focus is what lets us answer the phone, give you a real window, diagnose before we quote, and stand
          behind the work with a parts and labour warranty written on your invoice.
        </p>
        <ul class="about-bans">
          <li><Icon name="x" size={18} />No gas-line work — ovens and stoves are electric only</li>
          <li><Icon name="x" size={18} />No HVAC, furnaces or air conditioning</li>
          <li><Icon name="x" size={18} />No calls outside Vaughan city limits</li>
        </ul>
        <a class="link-arrow" href="/about/">Read how we work <Icon name="arrow" /></a>
      </div>
      <div class="about-media">
        <Photo slot="about-diagnostics" sizes="(min-width: 960px) 45vw, 100vw" />
        <div class="about-card">
          <p class="about-card__title">Aria at a glance</p>
          <dl>
            <div>
              <dt>Phone</dt>
              <dd><a href={site.phone.href} data-track="call-about-card">{site.phone.display}</a></dd>
            </div>
            <div>
              <dt>Hours</dt>
              <dd>{site.hours.long}</dd>
            </div>
            <div>
              <dt>Area</dt>
              <dd>Vaughan only · Woodbridge included</dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--paper-2 band--tight" aria-labelledby="brands-title">
    <div class="frame">
      <SectionHead eyebrow="Brands we service" title="The names in Vaughan kitchens and laundry rooms" id="brands-title">
        <p>
          Everyday freestanding units through to built-ins. Don’t see yours? Call — we’ll tell you straight whether
          it’s one we work on.
        </p>
      </SectionHead>
      <BrandPills />
    </div>
  </section>

  <CtaBand
    id="mid-cta"
    title="Need the appliance working again?"
    body={`Call ${site.phone.display} — we’ll ask a few quick questions, confirm a Vaughan window inside Monday–Sunday, 8am–10pm, and tell you honestly whether same-day is possible.`}
    track="mid"
  />

  <section class="band band--paper" aria-labelledby="faq-title">
    <div class="frame faq-grid">
      <div class="faq-intro">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title">Straight answers before you call</h2>
        <p class="lede">
          Scheduling, coverage, quotes, warranty and hours — the five questions Vaughan homeowners ask us most.
        </p>
        <div class="faq-call">
          <p class="faq-call__label">Still unsure?</p>
          <a class="faq-call__phone" href={site.phone.href} data-track="call-faq">
            <Icon name="phone" size={22} />{site.phone.display}
          </a>
          <p>{site.hours.long}. Describe the symptom and we’ll tell you on the phone whether it’s one we fix.</p>
        </div>
      </div>
      <FaqList items={homeFaqs} />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    background: var(--ink);
    isolation: isolate;
  }

  .hero__media {
    position: relative;
    height: clamp(150px, 22vh, 240px);
    overflow: hidden;
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(26, 26, 27, 0) 35%, rgba(26, 26, 27, 0.9) 100%);
  }

  .hero__media::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    height: 3px;
    background: var(--teal);
  }

  .hero__body {
    padding: 24px var(--pad-x) 44px;
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: 18px;
    max-width: 680px;
  }

  .hero__copy .eyebrow {
    margin-bottom: -4px;
  }

  .hero__copy h1 {
    max-width: 16ch;
  }

  .hero__rail {
    display: none;
  }

  @media (min-width: 768px) and (max-width: 1099.98px) {
    .hero__media {
      height: clamp(220px, 34vh, 380px);
    }
    .hero__body {
      padding-block: 40px 60px;
    }
  }

  /* ≥1100: full-bleed still under an ink scrim, copy overlay with a teal left accent. No 50/50 seam. */
  @media (min-width: 1100px) {
    .hero {
      display: grid;
      grid-template-rows: 1fr auto;
      min-height: clamp(640px, calc(100svh - var(--header-h)), 900px);
    }

    .hero__media {
      position: absolute;
      inset: 0;
      z-index: -1;
      height: auto;
    }

    .hero__media::before {
      display: none;
    }

    .hero__media::after {
      background:
        linear-gradient(
          90deg,
          rgba(26, 26, 27, 0.97) 0%,
          rgba(26, 26, 27, 0.9) 34%,
          rgba(26, 26, 27, 0.48) 62%,
          rgba(26, 26, 27, 0.1) 100%
        ),
        linear-gradient(0deg, rgba(26, 26, 27, 0.92) 0%, rgba(26, 26, 27, 0) 30%);
    }

    .hero__body {
      align-self: center;
      width: 100%;
      max-width: calc(var(--frame) + 2 * var(--pad-x));
      margin-inline: auto;
      padding: 64px var(--pad-x);
    }

    .hero__copy {
      gap: 22px;
      padding-left: clamp(24px, 2.4vw, 40px);
      border-left: 4px solid var(--teal);
    }

    .hero__rail {
      display: block;
      background: rgba(20, 20, 21, 0.8);
      border-top: 1px solid var(--line-soft);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }

    .hero__rail ul {
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      max-width: calc(var(--frame) + 2 * var(--pad-x));
      margin-inline: auto;
      padding-inline: var(--pad-x);
      list-style: none;
    }

    .hero__rail li + li {
      border-left: 1px solid var(--line-soft);
    }

    .hero__rail a {
      display: grid;
      gap: 4px;
      padding: 16px 16px 18px;
      font-size: 0.9375rem;
      font-weight: 650;
      line-height: 1.2;
      text-decoration: none;
      transition: background-color 0.16s ease;
    }

    .hero__rail li:first-child a {
      padding-left: 0;
    }

    .hero__rail a:hover {
      background: var(--teal-wash);
    }

    .hero__rail a:hover span:last-child {
      color: var(--teal-hi);
    }
  }

  /* ---------- Symptoms ---------- */
  .sym-grid {
    display: grid;
    gap: var(--gap);
    list-style: none;
  }

  @media (min-width: 640px) {
    .sym-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .sym-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .sym {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 22px 22px 24px;
    background: var(--char);
    border: 1px solid var(--line);
    border-left: 3px solid var(--teal);
    border-radius: var(--radius-sm);
    transition: background-color 0.16s ease;
  }

  .sym:hover {
    background: var(--char-2);
  }

  .sym__icon {
    color: var(--teal);
  }

  .sym p {
    color: var(--on-dark-2);
    font-size: 0.9375rem;
  }

  .sym .link-arrow {
    margin-top: auto;
    padding-top: 6px;
  }

  /* ---------- Process “have these ready” ---------- */
  .ready {
    display: grid;
    gap: 16px;
    margin-top: clamp(32px, 4vw, 52px);
    padding: clamp(20px, 2.4vw, 30px);
    background: var(--char);
    color: var(--on-dark);
    border-radius: var(--radius-sm);
  }

  .ready__title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .ready__title :global(svg) {
    color: var(--teal);
  }

  .ready ul {
    display: grid;
    gap: 12px 24px;
    list-style: none;
  }

  @media (min-width: 640px) {
    .ready ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ready ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .ready li {
    display: grid;
    gap: 2px;
    padding-left: 14px;
    border-left: 2px solid var(--teal);
  }

  .ready li span {
    font-size: 0.9375rem;
    color: var(--on-dark-2);
  }

  /* ---------- About teaser ---------- */
  .about-grid {
    display: grid;
    gap: 40px 64px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .about-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
  }

  .about-copy {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .about-copy .eyebrow {
    margin-bottom: -4px;
  }

  .about-copy > p:not(.eyebrow) {
    color: var(--on-dark-2);
    max-width: var(--measure);
  }

  .about-bans {
    display: grid;
    gap: 10px;
    list-style: none;
    padding: 16px 0;
    border-block: 1px solid var(--line-soft);
    width: 100%;
  }

  .about-bans li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }

  .about-bans :global(svg) {
    color: var(--teal);
    flex: none;
  }

  .about-media {
    position: relative;
    display: grid;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .about-media :global(picture) {
    grid-area: 1 / 1;
  }

  .about-media :global(img) {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
  }

  .about-card {
    background: rgba(26, 26, 27, 0.94);
    border-top: 3px solid var(--teal);
    padding: 20px 22px;
  }

  @media (min-width: 560px) {
    .about-card {
      grid-area: 1 / 1;
      align-self: end;
      margin: 20px;
      border: 1px solid var(--line);
      border-top: 3px solid var(--teal);
      border-radius: var(--radius-sm);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }
  }

  .about-card__title {
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .about-card dl {
    display: grid;
    gap: 10px 20px;
    margin: 0;
  }

  @media (min-width: 560px) {
    .about-card dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .about-card dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-3);
  }

  .about-card dd {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .about-card dd a {
    color: var(--teal);
  }

  /* ---------- FAQ ---------- */
  .faq-grid {
    display: grid;
    gap: 36px 64px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .faq-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
    }
    .faq-intro {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }

  .faq-intro {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .faq-intro .eyebrow {
    margin-bottom: -4px;
  }

  .faq-call {
    display: grid;
    gap: 8px;
    margin-top: 8px;
    padding: 22px;
    background: var(--char);
    color: var(--on-dark);
    border-radius: var(--radius-sm);
    border-top: 3px solid var(--teal);
  }

  .faq-call__label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .faq-call__phone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--teal);
    text-decoration: none;
  }

  .faq-call__phone:hover {
    color: var(--teal-hi);
    text-decoration: underline;
  }

  .faq-call__phone:focus-visible {
    outline-color: var(--teal);
  }

  .faq-call p:last-child {
    color: var(--on-dark-2);
    font-size: 0.9375rem;
  }
</style>
