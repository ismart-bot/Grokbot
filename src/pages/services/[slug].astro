---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import BrandPills from '../../components/BrandPills.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { services, serviceBySlug, serviceHref, type Service } from '../../data/services';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service: s } = Astro.props;
const related = s.related.map(serviceBySlug);
const majorAppliance = !['steam-unit', 'sauna-unit'].includes(s.slug);
const origin = Astro.site ?? new URL('https://ariaappliancerepair.com');
const pageUrl = new URL(serviceHref(s.slug), origin).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${s.name} repair & install`,
    serviceType: `${s.name} repair`,
    description: s.metaDescription,
    url: pageUrl,
    provider: { '@id': new URL('/#business', origin).href },
    areaServed: { '@type': 'City', name: `${site.area.city}, ${site.area.province}` },
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: site.hours.days,
      opens: site.hours.opens,
      closes: site.hours.closes,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', origin).href },
      { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', origin).href },
      { '@type': 'ListItem', position: 3, name: s.name, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={s.metaTitle} description={s.metaDescription} schema={schema}>
  <nav class="crumbs hide-sm" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/services/">Services</a></li>
      <li aria-current="page">{s.name}</li>
    </ol>
  </nav>

  <PageHero
    eyebrow={`${s.num} · ${s.name} · Vaughan`}
    title={s.h1}
    lede={s.heroLede}
    slot={`service-${s.slug}`}
    requestLabel={`Request ${s.noun} service`}
    track={`hero-${s.slug}`}
  >
    <ul class="chips">
      <li class="chip"><Icon name="clock" />{site.hours.short}</li>
      <li class="chip"><Icon name="shield" />Parts &amp; labour warranty</li>
      <li class="chip"><Icon name="check" />Upfront quote</li>
    </ul>
  </PageHero>

  <section class="band band--char band--seam" aria-labelledby="symptoms-title">
    <div class="frame">
      <SectionHead eyebrow="Symptoms" title={`When to call for ${s.noun} help`} id="symptoms-title">
        <p>{s.symptomsIntro}</p>
      </SectionHead>
      <ol class="symptoms">
        {
          s.symptoms.map((sym, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{sym.title}</h3>
                <p>{sym.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <aside class="tip" aria-label="Before we arrive">
        <span class="tip__icon"><Icon name="alert" size={22} /></span>
        <div>
          <p class="tip__title">Before we arrive</p>
          <p>{s.tip}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="band band--paper" aria-labelledby="included-title">
    <div class="frame included-grid">
      <div>
        <p class="eyebrow">What’s included</p>
        <h2 id="included-title">A clear {s.noun} visit</h2>
        <p class="lede">What you can expect when we arrive — before any repair starts.</p>
        <ul class="ticks">
          {
            s.included.map((item) => (
              <li>
                <Icon name="check" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="included-side">
        <div class="side-card">
          <p class="side-card__label">Parts &amp; systems we test</p>
          <ul class="tags">{s.parts.map((part) => <li>{part}</li>)}</ul>
        </div>
        <div class="side-card side-card--scope">
          <p class="side-card__label"><Icon name="x" size={16} />Scope</p>
          <p>{s.boundary}</p>
          <p class="side-card__small">
            Across every lane: no gas-line work, no HVAC, and Vaughan only.
            <a href="/services/#out-of-scope">What we don’t do</a>
          </p>
        </div>
        <div class="side-card side-card--dark">
          <p class="side-card__label">Warranty &amp; quote</p>
          <p>
            Parts &amp; labour warranty on every approved repair — terms stated on your invoice. Quote given after
            diagnosis, before any work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--ink" aria-labelledby="process-title">
    <div class="frame">
      <SectionHead eyebrow="Process" title={`How a ${s.noun} repair runs`} id="process-title">
        <p>
          Same three steps on every Vaughan job. Same-day when the schedule allows — we’ll tell you honestly on the
          call.
        </p>
      </SectionHead>
      <ProcessSteps steps={s.process} />
    </div>
  </section>

  {
    majorAppliance && (
      <section class="band band--paper-2 band--tight" aria-labelledby="brands-title">
        <div class="frame">
          <SectionHead eyebrow="Brands" title="Brands we commonly see" id="brands-title">
            <p>Don’t see your brand? Call with the model number and we’ll tell you straight.</p>
          </SectionHead>
          <BrandPills />
        </div>
      </section>
    )
  }

  <section class="band band--paper" aria-labelledby="faq-title">
    <div class="frame faq-grid">
      <div>
        <p class="eyebrow">{s.name} FAQ</p>
        <h2 id="faq-title">Questions we get about {s.noun}s</h2>
        <p class="lede">Short, honest answers. For anything else, a two-minute call is faster than a form.</p>
        <a class="link-arrow" href={site.phone.href} data-track={`call-faq-${s.slug}`}>
          <Icon name="phone" />Call {site.phone.display}
        </a>
      </div>
      <FaqList items={s.faqs} />
    </div>
  </section>

  <section class="band band--char" aria-labelledby="related-title">
    <div class="frame">
      <SectionHead eyebrow="Related services" title="Often booked alongside" id="related-title">
        <a class="link-arrow" href="/services/">All eight services <Icon name="arrow" /></a>
      </SectionHead>
      <ServiceCards items={related} />
    </div>
  </section>

  <CtaBand
    title={`${s.name} acting up in Vaughan?`}
    body={`Call ${site.phone.display} — tell us the brand, model and what it’s doing. Same-day when available, inside Monday–Sunday, 8am–10pm.`}
    track={`band-${s.slug}`}
  />
</BaseLayout>

<style>
  .crumbs {
    background: var(--ink);
    border-bottom: 1px solid var(--line-soft);
    padding: 10px var(--pad-x);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    max-width: var(--frame);
    margin-inline: auto;
    list-style: none;
    font-size: 0.875rem;
    color: var(--on-dark-3);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    color: var(--line);
  }

  .crumbs a {
    color: var(--on-dark-2);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--teal);
    text-decoration: underline;
  }

  .crumbs [aria-current] {
    color: var(--on-dark);
  }

  /* Symptoms */
  .symptoms {
    display: grid;
    gap: 0 var(--gap);
    list-style: none;
    border-top: 1px solid var(--line-soft);
  }

  @media (min-width: 760px) {
    .symptoms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .symptoms {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .symptoms li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .symptoms .num {
    padding-top: 3px;
  }

  .symptoms h3 {
    margin-bottom: 6px;
    font-size: 1.0625rem;
  }

  .symptoms p {
    font-size: 0.9375rem;
    color: var(--on-dark-2);
  }

  .tip {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    margin-top: clamp(24px, 3vw, 40px);
    padding: 20px 22px;
    border: 1px solid var(--teal-edge);
    border-left: 4px solid var(--teal);
    border-radius: var(--radius-sm);
    background: var(--teal-wash);
  }

  .tip__icon {
    color: var(--teal);
  }

  .tip__title {
    margin-bottom: 4px;
    font-weight: 700;
  }

  .tip p:last-child {
    color: var(--on-dark-2);
    max-width: 90ch;
  }

  /* Included */
  .included-grid {
    display: grid;
    gap: 40px 64px;
  }

  @media (min-width: 960px) {
    .included-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }
  }

  .included-grid h2 {
    margin-bottom: 12px;
  }

  .included-grid .lede {
    margin-bottom: 22px;
  }

  .included-side {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .side-card {
    display: grid;
    gap: 12px;
    padding: 22px;
    background: var(--white);
    border: 1px solid var(--paper-line);
    border-radius: var(--radius-sm);
  }

  .side-card__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-deep);
  }

  .side-card--scope {
    border-left: 4px solid var(--teal-deep);
  }

  .side-card__small {
    font-size: 0.9375rem;
    color: var(--on-paper-2);
  }

  .side-card__small a {
    color: var(--teal-deep);
    font-weight: 600;
  }

  .side-card--dark {
    background: var(--char);
    border-color: var(--char);
    color: var(--on-dark);
  }

  .side-card--dark .side-card__label {
    color: var(--teal);
  }

  .side-card--dark p:last-child {
    color: var(--on-dark-2);
  }

  /* FAQ */
  .faq-grid {
    display: grid;
    gap: 32px 64px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .faq-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
    }
  }

  .faq-grid h2 {
    margin-bottom: 12px;
  }

  .faq-grid .lede {
    margin-bottom: 18px;
  }
</style>
